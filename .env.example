# Prior Labs TabPFN API token (platform.priorlabs.ai, accept the non-commercial license)
TABPFN_TOKEN=

# Google AI Studio API key (aistudio.google.com/apikey), used to call Gemma
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# google = Gemma via Google AI Studio, ollama = local Gemma via Ollama
LLM_PROVIDER=google
OLLAMA_MODEL=gemma3:1b
OLLAMA_URL=http://localhost:11434

# tabpfn = Prior Labs API, sklearn = offline gradient-boosting stand-in for development only
FORECAST_BACKEND=tabpfn

CURRENCY_SYMBOL=₦
